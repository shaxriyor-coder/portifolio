# ---- Django ----
# Strong random value in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-secret

# False in production
DEBUG=False

# Comma-separated. ".vercel.app" covers every preview/prod deploy URL;
# add your custom domain too.
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,your-domain.com

# ---- Database (PostgreSQL) ----
# Use a managed Postgres (Neon, Supabase, Vercel Postgres, ...).
# Vercel has an ephemeral filesystem, so SQLite is NOT usable in production.
# Neon example (note the required sslmode):
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require

# ---- CORS / CSRF ----
# Frontend origin(s) allowed to call the API (scheme required).
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
# Origins trusted for Django admin POST/login over HTTPS (scheme required, wildcards ok).
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com

# ---- Local development only ----
# For local dev without Postgres you can instead point DATABASE_URL at SQLite:
#   DATABASE_URL=sqlite:///db.sqlite3
# and set DEBUG=True.
